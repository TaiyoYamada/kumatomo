  CAFE @map("カフェ")
  IZAKAYA @map("居酒屋")
  YAKINIKU @map("焼肉")
  SUSHI @map("寿司")
  SWEETS @map("スイーツ")
  FAST_FOOD @map("ファストフード")
  RESTAURANT @map("レストラン")
  BAR @map("バー")
  BAKERY @map("ベーカリー")
  ITALIAN @map("イタリアン")
  CHINESE @map("中華")
  KOREAN @map("韓国料理")
  FRENCH @map("フレンチ")
  JAPANESE @map("和食")
  WESTERN @map("洋食")
  SEAFOOD @map("海鮮")
  VEGETARIAN @map("ベジタリアン")
  BBQ @map("BBQ")
  OTHER @map("その他")
}

model PasswordResetToken {
  id BigInt @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  @@map("password_reset_tokens")
}
model Cache {
  key String @id
  value String
  expiration Int
  @@map("cache")
}
model CacheLock {
  key String @id
  owner String
  expiration Int
  @@map("cache_locks")
}
model User {
  id BigInt @id @default(autoincrement())
  email String
  email_verified_at DateTime?
  password String
  has_completed_setup Boolean @default(false)
  name String?
  username String?
  bio String?
  location String?
  post_count Int @default(0)
  profile_image_url String?
  cover_image_url String?
  followers_count Int @default(0)
  following_count Int @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?
  sessions Session[]
  posts Post[]
  aiChatLogs AiChatLog[]
  comments Comment[]
  likes Like[]
  bookmarks Bookmark[]
  favorites Favorite[]
  shopProposals ShopProposal[]
  @@map("users")
}
model Shop {
  id BigInt @id @default(autoincrement())
  name String
  description String?
  address String?
  phone String?
  business_hours String?
  genre String?
  latitude Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)
  image_url String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  has_try_benefit Boolean @default(false)
  stamp_count Int @default(0)
  is_approved Boolean @default(true)
  posts Post[]
  favorites Favorite[]
  @@map("shops")
}
model Post {
  id BigInt @id @default(autoincrement())
  user_id BigInt
  title String?
  content String?
  image_url String?
  tags Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  shop_id BigInt?
  user User @relation(fields: [user_id], references: [id])
  shop Shop? @relation(fields: [shop_id], references: [id])
  images PostImage[]
  comments Comment[]
  likes Like[]
  bookmarks Bookmark[]
  @@map("posts")
}
model PostImage {
  id BigInt @id @default(autoincrement())
  post_id BigInt
  image_url String
  display_order Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  post Post @relation(fields: [post_id], references: [id])
  @@map("post_images")
}
model Comment {
  id BigInt @id @default(autoincrement())
  post_id BigInt
  user_id BigInt
  content String
  image_url String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  post Post @relation(fields: [post_id], references: [id])
  user User @relation(fields: [user_id], references: [id])
  @@map("comments")
}
model Like {
  id BigInt @id @default(autoincrement())
  post_id BigInt
  user_id BigInt
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  post Post @relation(fields: [post_id], references: [id])
  user User @relation(fields: [user_id], references: [id])
  @@unique([post_id, user_id], name: "unique_like")
  @@map("likes")
}
model Bookmark {
  id BigInt @id @default(autoincrement())
  post_id BigInt
  user_id BigInt
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  post Post @relation(fields: [post_id], references: [id])
  user User @relation(fields: [user_id], references: [id])
  @@unique([post_id, user_id], name: "unique_bookmark")
  @@map("bookmarks")
}
model Favorite {
  id BigInt @id @default(autoincrement())
  user_id BigInt
